# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Company / Sender Details (appear on every invoice)
COMPANY_NAME=Acme Corp Ltd
COMPANY_ADDRESS=123 Business Street
COMPANY_CITY=London
COMPANY_POSTCODE=EC1A 1BB
COMPANY_COUNTRY=United Kingdom
COMPANY_EMAIL=billing@acmecorp.com
COMPANY_PHONE=+44 20 1234 5678
COMPANY_VAT=GB123456789

# Invoice Settings
TAX_RATE=0.20
CURRENCY_SYMBOL=£
INVOICE_PREFIX=INV

# ────────────────────────────────────────────────────────────────────────────
# VolunteerHub Settings
# ────────────────────────────────────────────────────────────────────────────
# Flask secret key – change this in production
SECRET_KEY=change-me-in-production

# Database URL (defaults to SQLite if not set)
# Postgres example: postgresql://user:password@localhost:5432/volunteerhub
DATABASE_URL=sqlite:///volunteer_manager.db

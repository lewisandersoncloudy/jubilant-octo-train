# Council Finance — Environment Configuration
# Copy this file to .env and set your values

# REQUIRED in production — use a long random string
SECRET_KEY=change-me-to-a-long-random-secret-key

# Optional — defaults to a local SQLite file (council_finance.db)
# DATABASE_URL=sqlite:///council_finance.db

# Flask debug mode — never set to True in production
FLASK_DEBUG=False
